# Copy to worker/.dev.vars for `npm run worker:dev`. NEVER commit real secrets.
# These mirror the `wrangler secret put` values for production.

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Operator password (POST /auth/login → 8-hour session token).
TRIGGER_SECRET=choose-a-long-random-string
# Admin credential (x-admin-secret): cycles, runs, kill-switch release. Use a
# different value from TRIGGER_SECRET; falls back to it when unset.
ADMIN_SECRET=choose-a-different-long-random-string
