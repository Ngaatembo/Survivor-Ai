# ============================================================================
# SURVIVE AI — environment variables
# Copy to `.env` for local browser dev (Vite) or use with the seed script.
# VITE_ vars are exposed to the browser — only ever put ANON/SEARCH keys here,
# never service-role keys. The Cloudflare Worker holds real secrets
# (see worker/.dev.vars.example).
# ============================================================================

# --- Live backend (recommended) --------------------------------------------
# When set, the dashboard mirrors the deployed Worker/D1 backend read-only
# (GET /state + /health) instead of running its own local demo simulation.
# See DEPLOYMENT.md section 4.
VITE_API_BASE_URL=https://survivor-ai-backend.YOUR-SUBDOMAIN.workers.dev

# --- Supabase (optional in browser; worker uses service role) --------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Paid providers: NEVER in the browser ----------------------------------
# AI and search keys belong only to the Worker (wrangler secret put …), where
# every paid call is authorized and recorded. The dashboard ignores any
# VITE_ANTHROPIC/OPENAI/TAVILY/BRAVE key; do not set them.

# --- Seed script only (NEVER expose in the browser; keep server-side) ------
# Used by: npm run seed:supabase
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
